    "# 1. Ustawienia\n",
    "BINARY_VARS = ['hasParkingSpace', 'hasBalcony', 'hasElevator', 'hasSecurity', 'hasStorageRoom']\n",
    "CONFIDENCE_LEVEL = 0.99\n",
    "Z_SCORE = stats.norm.ppf(1 - (1 - CONFIDENCE_LEVEL) / 2)\n",
    "\n",
    "# 2. Obliczenia\n",
    "results = []\n",
    "for var in BINARY_VARS:\n",
    "    data = df[var].dropna()\n",
    "    n = len(data)\n",
    "    if n < 30: continue\n",
    "        \n",
    "    p_hat = data.mean() \n",
    "    moe = Z_SCORE * np.sqrt(p_hat * (1 - p_hat) / n)\n",
    "    \n",
    "    results.append({\n",
    "        'Zmienna': var,\n",
    "        'Proporcja': p_hat,\n",
    "        'ME': moe,\n",
    "        'Lower': max(0, p_hat - moe),\n",
    "        'Upper': min(1, p_hat + moe)\n",
    "    })\n",
    "\n",
    "res_df = pd.DataFrame(results)\n",
    "\n",
    "# 3. Wyświetlenie wyników\n",
    "print(\"## 📊 Przedziały Ufności (99%):\")\n",
    "print(res_df[['Zmienna', 'Proporcja', 'Lower', 'Upper']].to_string(index=False))\n",
    "\n",
    "# 4. Wizualizacja\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "\n",
    "plt.errorbar(x=res_df['Proporcja'], y=res_df['Zmienna'], xerr=res_df['ME'],\n",
    "             fmt='o', capsize=5, color='darkblue', ecolor='skyblue', \n",
    "             elinewidth=3, markerfacecolor='red', markersize=8)\n",
    "\n",
    "plt.title(f'{int(CONFIDENCE_LEVEL*100)}% Przedziały Ufności dla Cech Nieruchomości')\n",
    "plt.xlabel('Proporcja występowania (0-1)')\n",
    "plt.xlim(0, 1)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
