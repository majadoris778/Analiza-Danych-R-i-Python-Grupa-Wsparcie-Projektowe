    "# Obliczamy średnią cenę dla każdego miasta\n",
    "# 1. Tworzymy słownik poprawek\n",
    "city_corrections = {\n",
    "    'warszawa': 'Warszawa',\n",
    "    'lodz': 'Łódź',\n",
    "    'wroclaw': 'Wrocław',\n",
    "    'poznan': 'Poznań',\n",
    "    'gdansk': 'Gdańsk',\n",
    "    'krakow': 'Kraków',\n",
    "    'bialystok': 'Białystok',\n",
    "    'czestochowa': 'Częstochowa',\n",
    "}\n",
    "\n",
    "# 2. Mapujemy nazwy i poprawiamy wielkość liter dla pozostałych\n",
    "df['city'] = df['city'].str.lower().map(city_corrections).fillna(df['city'].str.capitalize())\n",
    "\n",
    "# 3. Obliczamy średnią cenę\n",
    "avg_price_by_city = df.groupby('city')['price'].mean().round(2).reset_index(name='avg_price').sort_values('avg_price', ascending=False)\n",
    "avg_price_by_city"
   ]
